{
  "title": "AgentForge Clinical Co-Pilot",
  "uid": "agentforge",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Agent Turn Rate",
      "description": "Completed agent turns/sec (this app's traffic unit - SignalR hub invocations, not classic HTTP requests). ARCHITECTURE.md §11's 'request count'.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(agentforge_agent_turns_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Agent Turn Error Rate",
      "description": "Fraction of agent turns that threw (see AgentForgeHighTurnErrorRate alert).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(agentforge_agent_turns_total{outcome=\"failure\"}[5m])) / sum(rate(agentforge_agent_turns_total[5m]))",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "id": 3,
      "title": "Agent Turn Latency (p50 / p95)",
      "description": "Wall-clock duration of one agent turn (see AgentForgeHighTurnLatencyP95 alert).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(agentforge_agent_turn_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(agentforge_agent_turn_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tool Call Rate by Tool",
      "description": "MCP tool calls dispatched/sec, by tool name.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tool) (rate(agentforge_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tool Call Failure Rate by Tool",
      "description": "Fraction of calls failing, per tool (see AgentForgeHighToolFailureRate alert).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (tool) (rate(agentforge_tool_calls_total{outcome=\"failure\"}[5m])) / sum by (tool) (rate(agentforge_tool_calls_total[5m]))",
          "legendFormat": "{{tool}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Verification Pass/Fail Rate",
      "description": "FR-VERIF-0 gate outcomes (see AgentForgeElevatedVerificationFailureRate alert). Suppressed content never ships - a rising fail rate is a product-quality signal, not an outage.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(agentforge_verification_results_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "LLM Tokens/sec by Direction",
      "description": "Input vs. output token throughput (FR-OBS-2).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (direction) (rate(agentforge_llm_tokens_total[5m]))",
          "legendFormat": "{{direction}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM Cost Rate (USD/sec)",
      "description": "Estimated spend rate from LlmUsage.EstimatedCostUsd.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(agentforge_llm_cost_usd_total[5m]))",
          "legendFormat": "cost/sec"
        }
      ]
    },
    {
      "id": 9,
      "title": "Resilience (Polly) - retries & pipeline events, raw",
      "description": "Microsoft.Extensions.Http.Resilience's own telemetry (Program.cs subscribes the 'Polly' meter) - raw table rather than a specific metric name, since the exact Prometheus-exported name for a given Polly/OTel SDK version is best confirmed live rather than hard-coded here.",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "{otel_scope_name=\"Polly\"}",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 10,
      "title": "Week 2 - Multimodal Evidence Agent",
      "type": "row",
      "gridPos": { "x": 0, "y": 24, "w": 24, "h": 1 },
      "collapsed": false
    },
    {
      "id": 11,
      "title": "Document Ingestion Rate by Outcome",
      "description": "agentforge.document_ingestions - ingested / already_ingested / extraction_rejected per second (FR-OBS-W2-1).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 25, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome) (rate(agentforge_document_ingestions_total[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Document Ingestion Latency (p95)",
      "description": "95th-percentile wall-clock of one ingestion attempt.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 25, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(agentforge_document_ingestion_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 13,
      "title": "Graph Worker Latency p95 by Worker",
      "description": "Per-worker wall-clock across the supervisor graph (intake-extractor / evidence-retriever / answer-composer / critic).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 25, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, worker) (rate(agentforge_worker_duration_seconds_bucket[5m])))",
          "legendFormat": "{{worker}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Supervisor Routing Decisions",
      "description": "Handoffs per second by destination node - the inspectable routing trail (FR-GRAPH-1).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 33, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (to) (rate(agentforge_routing_decisions_total[5m]))",
          "legendFormat": "-> {{to}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Evidence Retrieval Hit Rate",
      "description": "Fraction of evidence-retrieval calls that returned at least one snippet (FR-RAG-2 observability).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 33, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(agentforge_evidence_retrievals_total{outcome=\"hit\"}[5m])) / sum(rate(agentforge_evidence_retrievals_total[5m]))",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 16,
      "title": "Evidence Retrieval Latency (p95)",
      "description": "95th-percentile wall-clock of one evidence-retrieval call.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 33, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(agentforge_evidence_retrieval_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 17,
      "title": "Rerank Latency (p50 / p95)",
      "description": "agentforge.rerank.duration - wall-clock of one cross-encoder rerank call (Cohere rerank-v3.5). The added hop the hybrid retriever pays over sparse-only; watch it against the evidence-retrieval budget.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 41, "w": 8, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum(rate(agentforge_rerank_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(agentforge_rerank_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 18,
      "title": "Retrieval Degradations by Stage",
      "description": "agentforge.retrieval_degradations - a half or the reranker failed and was skipped, per second by stage (sparse / dense / rerank). Non-zero rerank means answers fell back to the fused order without cross-encoder reordering (see AgentForgeRetrievalDegradation alert).",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 41, "w": 8, "h": 8 },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (stage) (rate(agentforge_retrieval_degradations_total[5m]))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 19,
      "title": "Per-encounter story (FR-OBS-W2-1)",
      "description": "One line per chat turn tying the encounter together: tool sequence, per-step + turn latency, tokens, cost, retrieval hits, extraction confidence, and the runtime verification (eval) outcome. Correlation-id scoped, no PHI - filter one CorrelationId to answer all seven for a single past encounter.",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "x": 0, "y": 50, "w": 24, "h": 11 },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"agentforge-api\"} |= \"encounter.telemetry\"",
          "queryType": "range"
        }
      ]
    }
  ]
}
