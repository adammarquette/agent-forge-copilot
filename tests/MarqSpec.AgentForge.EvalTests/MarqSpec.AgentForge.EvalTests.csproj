<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707 (no underscores) conflicts with the Method_State_ExpectedResult test-naming
         convention (ENGINEERING_STANDARDS.md §8). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the deterministic eval building blocks (GoldenCase, RubricEvaluator, Stub/CapturingLogger)
         from the console gate so both share one extraction pipeline; internals exposed via
         InternalsVisibleTo in that project. reference: evals/README.md -->
    <ProjectReference Include="..\MarqSpec.AgentForge.Evals\MarqSpec.AgentForge.Evals.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
