<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- CA1707 (no underscores) conflicts with the mandated Method_State_ExpectedResult
         test-naming convention (ENGINEERING_STANDARDS.md §8). -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="FakeItEasy" />
    <PackageReference Include="JunitXml.TestLogger" />
  </ItemGroup>

  <ItemGroup>
    <!-- ISession and other ASP.NET Core abstractions for testing the BFF (Epic 3) -
         part of the shared framework, not a NuGet package, for a non-Sdk.Web project. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AgentForge.Integration.OpenEmr\AgentForge.Integration.OpenEmr.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Llm\AgentForge.Llm.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Mcp\AgentForge.Mcp.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Observability\AgentForge.Observability.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Agent\AgentForge.Agent.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Api\AgentForge.Api.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Verification\AgentForge.Verification.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Documents\AgentForge.Documents.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Agents\AgentForge.Agents.csproj" />
    <ProjectReference Include="..\..\src\AgentForge.Retrieval\AgentForge.Retrieval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
