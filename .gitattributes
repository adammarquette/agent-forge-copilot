# Normalize to LF in the repository regardless of a contributor's core.autocrlf setting,
# so a fresh Windows clone doesn't immediately fail `dotnet format --verify-no-changes`
# (.editorconfig requires end_of_line = lf).
* text=auto eol=lf

# Binary files - do not touch line endings.
*.pptx binary
*.pdf binary
*.dll binary
*.png binary
*.jpg binary
*.ico binary
